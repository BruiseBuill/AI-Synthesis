{
  "name": "synthesis-solo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:core": "vitest run src/game-core",
    "test:score": "vitest run src/game-core/score-test-kit.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:deployment": "playwright test --config playwright.deployment.config.ts",
    "test:e2e:score": "playwright test -g \"score|seal|synthesis header\"",
    "verify:core": "pnpm test:core && pnpm build",
    "verify:all": "pnpm test && pnpm build && pnpm test:e2e && pnpm test:e2e:deployment"
  },
  "dependencies": {
    "lucide-react": "^0.536.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "read-excel-file": "^9.3.5",
    "seedrandom": "^3.0.5",
    "zod": "^4.0.10",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-react": "^4.6.0",
    "fast-check": "^4.2.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
